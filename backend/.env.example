APP_ENV=development
DATABASE_URL=sqlite:///./data/leafai.db
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173
MODEL_PATH=../model/model.pt
MODEL_IMG_SIZE=640
MODEL_CONFIDENCE_THRESHOLD=0.25
MAX_UPLOAD_SIZE_MB=10

# Trợ lý hỏi đáp giọng nói (tùy chọn). Để trống: trợ lý trả lời từ thư viện bệnh, không gọi AI.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5

# Bảo mật production (bắt buộc khi APP_ENV=production): chuỗi ngẫu nhiên >= 32 ký tự
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Chạy sau reverse proxy (Render/HF Spaces) thì bật để giới hạn tần suất theo IP thật
TRUST_PROXY_HEADERS=false

# Job cảnh báo định kỳ (GitHub Actions gọi /api/internal/jobs/alerts)
CRON_SECRET=

# Web Push: python -m app.scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Lưu ảnh: local | supabase (bucket riêng tư, dùng service role key — KHÔNG đưa key này lên frontend)
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=leaf-images

# Trợ lý hỏi đáp: auto = Gemini nếu có GEMINI_API_KEY, rồi Claude nếu có ANTHROPIC_API_KEY
ASSISTANT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
