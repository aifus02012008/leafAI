# ============================================================
# LEAF_AI — biến môi trường mẫu
# Cách dùng:  cp .env.example .env   (rồi điền giá trị thật)
# File .env nằm cạnh manage.py (backend/.env) — .gitignore đã loại trừ.
# Chi tiết cách lấy giá trị: xem docs/DEPLOY.md
# ============================================================

# ---------- Django core ----------
# Tạo mới bằng: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# Dev local = True. Trên Render/Vercel để False (render.yaml đã set).
DEBUG=True
# Danh sách host cách nhau dấu phẩy, ví dụ: localhost,127.0.0.1,leaf-ai.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Database (Neon PostgreSQL) ----------
# Neon Dashboard > Connect > Connection string (dùng Pooler cho production).
# Bỏ trống hoặc đặt sqlite:///db.sqlite3 thì Django tự dùng backend/db.sqlite3 (chỉ dev).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ---------- Gemini Vision (pipeline chẩn đoán bệnh lá) ----------
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — model mặc định là gemini-2.5-flash nếu không set
GEMINI_MODEL=gemini-2.5-flash

# ---------- Cloudinary (lưu trữ ảnh khi deploy) ----------
# Cloudinary Dashboard > Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Supabase (đồng bộ lịch sử chẩn đoán — optional) ----------
# Project Settings > API. Ưu tiên service role; không có thì dùng key bên dưới.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dự phòng (đọc theo thứ tự ưu tiên): SUPABASE_KEY, SUPABASE_ANON_KEY
# SUPABASE_KEY=
# SUPABASE_ANON_KEY=

# ---------- Thêm origin riêng (optional) ----------
# settings đã tự có https://*.onrender.com và https://*.vercel.app.
# Chỉ cần set khi dùng custom domain, cách nhau dấu phẩy:
# CSRF_TRUSTED_ORIGINS=https://leafai.example.com

# ---------- Biến nội bộ — KHÔNG tự khai báo ----------
# VERCEL=1                      # api/index.py tự set khi chạy trên Vercel
# GEMINI_DEFAULT_MODEL=...      # tên cũ, vẫn được đọc làm fallback
